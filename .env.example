# Local development only. Never commit real secrets.
DATABASE_URL="postgresql://clm@localhost:5433/clm"
SESSION_SECRET="dev-only-change-me-dev-only-change-me-0001"
# 64 hex chars = 256-bit key for encrypting stored documents at rest (local storage adapter)
STORAGE_KEY="6f1c2b8a9d0e4f3a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a9b8c7d6e5f40"
STORAGE_DIR="./storage"
# auth: "dev" shows the demo-account picker; "oidc" requires OIDC_* settings (see docs/INTEGRATIONS.md)
AUTH_MODE="dev"
ESIGN_PROVIDER="mock"
EMAIL_PROVIDER="outbox"
APP_BASE_URL="http://localhost:3000"
# Allows the development e-signature mock when running a production build (demo servers only)
ALLOW_MOCK_ESIGN="false"
# Required with AUTH_MODE=dev on a production build (demonstration servers only)
ALLOW_DEMO_LOGIN="false"

# Hosting on Vercel (see docs/VERCEL.md)
# STORAGE_PROVIDER="db"     # defaults to db on Vercel: encrypted files in PostgreSQL
# CRON_SECRET=""            # 16+ chars; required for /api/cron/jobs
# DEMO_ACCESS_CODE=""       # optional: visitors must enter this before choosing a demo account
# SEED_DEMO="true"          # load synthetic demo data on first deploy
# MAX_UPLOAD_MB="4"         # defaults to 4 on Vercel (platform request limit 4.5 MB)
