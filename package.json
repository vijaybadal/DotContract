{
  "name": "dotcomm-clm",
  "version": "0.1.0",
  "private": true,
  "description": "DOTComm IT Contract Lifecycle Management — Phase 1 thin slice",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset-db.ts && tsx scripts/migrate.ts && tsx scripts/seed.ts",
    "jobs": "tsx scripts/run-jobs.ts",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "e2e": "node e2e/scenarios.e2e.mjs",
    "vercel-build": "tsx scripts/vercel-build.ts && next build",
    "css:prebuilt": "tailwindcss -i src/app/globals.css -o src/app/globals.prebuilt.css --minify && node scripts/stamp-css.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@fontsource-variable/public-sans": "^5.3.0",
    "diff": "^8.0.2",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "next": "15.5.28",
    "pg": "^8.23.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "drizzle-kit": "^0.31.11",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "22.x"
  },
  "optionalDependencies": {
    "@next/swc-wasm-nodejs": "^15.5.28"
  }
}
